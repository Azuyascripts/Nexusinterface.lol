                    gunHl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    gunHl.Enabled = true

                    local bill = adornee:FindFirstChild("NEXUS_GunBill") or Instance.new("BillboardGui", adornee)
                    bill.Name = "NEXUS_GunBill"
                    bill.Adornee = adornee
                    bill.Size = UDim2.new(0, 140, 0, 40)
                    bill.AlwaysOnTop = true
                    bill.ExtentsOffset = Vector3.new(0, 1.8, 0)

                    local lbl = bill:FindFirstChild("TextLabel") or Instance.new("TextLabel", bill)
                    lbl.Size = UDim2.new(1, 0, 1, 0)
                    lbl.BackgroundTransparency = 1
                    lbl.Font = Enum.Font.Code
                    lbl.TextSize = 12
                    lbl.Text = "DROPPED GUN\n▼"
                    lbl.TextColor3 = NexusGreen
                    lbl.TextStrokeTransparency = 0
                    bill.Enabled = true
                end
            elseif lastDroppedGunPos and not detectedHeroPlayer then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                        local dist = (p.Character.HumanoidRootPart.Position - lastDroppedGunPos).Magnitude
                        if dist <= 6 then
                            detectedHeroPlayer = p
                            break
                        end
                    end
                end
            end

            if not initialSheriff then
                for _, p in ipairs(Players:GetPlayers()) do
                    local bp = p:FindFirstChild("Backpack")
                    local hasGun = (bp and bp:FindFirstChild("Gun")) or (p.Character and p.Character:FindFirstChild("Gun"))
                    if hasGun and not lastDroppedGunPos then
                        initialSheriff = p
                        break
                    end
                end
            end

            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= lp and p.Character and p.Character:FindFirstChild("Head") then
                    local char = p.Character
                    local head = char.Head
                    
                    local hl = char:FindFirstChild("NEXUS_Highlight") or Instance.new("Highlight", char)
                    hl.Name = "NEXUS_Highlight"
                    hl.FillTransparency = 0.3
                    hl.OutlineTransparency = 0

                    local bp = p:FindFirstChild("Backpack")
                    local hasKnife = (bp and bp:FindFirstChild("Knife")) or char:FindFirstChild("Knife")
                    local hasGun = (bp and bp:FindFirstChild("Gun")) or char:FindFirstChild("Gun")
                    
                    local roleName, roleColor = "INNOCENT", NexusGreen
                    if hasKnife then
                        roleName, roleColor = "MURDERER", Color3.fromRGB(255, 30, 30)
                    elseif p == detectedHeroPlayer or (hasGun and p ~= initialSheriff and lastDroppedGunPos) then
                        roleName, roleColor = "HERO", Color3.fromRGB(255, 235, 0)
                    elseif p == initialSheriff or (hasGun and not lastDroppedGunPos) then
                        roleName, roleColor = "SHERIFF", Color3.fromRGB(30, 140, 255)
                    end
                    
                    hl.FillColor = roleColor
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    hl.Enabled = true

                    local bill = head:FindFirstChild("NEXUS_Bill") or Instance.new("BillboardGui", head)
                    bill.Name = "NEXUS_Bill"
                    bill.Adornee = head
                    bill.Size = UDim2.new(0, 140, 0, 40)
                    bill.AlwaysOnTop = true
                    bill.ExtentsOffset = Vector3.new(0, 2.5, 0)

                    local lbl = bill:FindFirstChild("TextLabel") or Instance.new("TextLabel", bill)
                    lbl.Size = UDim2.new(1, 0, 1, 0)
                    lbl.BackgroundTransparency = 1
                    lbl.Font = Enum.Font.Code
                    lbl.TextSize = 13
                    lbl.Text = roleName .. "\n▼"
                    lbl.TextColor3 = roleColor
                    lbl.TextStrokeTransparency = 0
                    bill.Enabled = true
                end
            end
        else
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Character then
                    if p.Character:FindFirstChild("NEXUS_Highlight") then p.Character.NEXUS_Highlight.Enabled = false end
                    if p.Character:FindFirstChild("Head") and p.Character.Head:FindFirstChild("NEXUS_Bill") then
                        p.Character.Head.NEXUS_Bill.Enabled = false
                    end
                end
            end
        end
        task.wait(0.2)
    end
end)

