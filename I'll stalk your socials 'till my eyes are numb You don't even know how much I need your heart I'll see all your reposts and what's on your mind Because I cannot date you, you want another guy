local function isPhysicalDroppedGun(obj)
    if not obj then return false end
    if obj.Name == "GunDrop" or obj.Name == "Gun" then
        if obj:IsA("BasePart") or obj:IsA("Model") then
            return true
        end
    end
    return false
end

