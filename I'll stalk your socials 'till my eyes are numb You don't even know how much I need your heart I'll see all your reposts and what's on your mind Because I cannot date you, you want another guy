-- =================================================================
-- COMBAT ENGINE & TWEEN FLICK
-- =================================================================
local function getMurderer()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp then
            if (p:FindFirstChild("Backpack") and p.Backpack:FindFirstChild("Knife")) or (p.Character and p.Character:FindFirstChild("Knife")) then
                return p
            end
        end
    end
    return nil
end

local function executeTweenFlick(targetPos, actionCallback)
    if not _G.FlickEnabled then
        if actionCallback then actionCallback() end
        return
    end

    local duration = flickSpeeds[_G.FlickSpeedMode] or 0.06
    local targetCFrame = CFrame.new(Camera.CFrame.Position, targetPos)

    Camera.CameraType = Enum.CameraType.Scriptable
    local tween = TweenService:Create(Camera, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {CFrame = targetCFrame})
    tween:Play()
    tween.Completed:Wait()

    if actionCallback then actionCallback() end
    task.wait(0.02)
    Camera.CameraType = Enum.CameraType.Custom
end

local function fireGun()
    local char = lp.Character 
    local hum = char and char:FindFirstChild("Humanoid")
    if not hum then return end
    local gun = char:FindFirstChild("Gun") or lp.Backpack:FindFirstChild("Gun")
    local murd = getMurderer()
    if gun and murd and murd.Character then
        local targetPart = murd.Character:FindFirstChild(_G.TargetPart) or murd.Character.HumanoidRootPart
        if targetPart then
            if gun.Parent ~= char then hum:EquipTool(gun) end
            local targetPos = targetPart.Position + (targetPart.AssemblyLinearVelocity * 0.12)
            executeTweenFlick(targetPos, function()
                local remote = gun:FindFirstChild("Shoot") or ReplicatedStorage:FindFirstChild("ShootGun", true)
                if remote then remote:FireServer(CFrame.lookAt(targetPart.Position, targetPos), CFrame.new(targetPos)) end
                gun:Activate()
            end)
            task.delay(0.2, function()
                if gun and gun.Parent == char and lp:FindFirstChild("Backpack") then
                    gun.Parent = lp.Backpack
                end
            end)
        end
    end
end

local function throwAction()
    local char = lp.Character if not char then return end
    local knife = char:FindFirstChild("Knife") or lp.Backpack:FindFirstChild("Knife")
    local near, dist = nil, math.huge
    for _, v in pairs(Players:GetPlayers()) do
        if v ~= lp and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
            local d = (char.HumanoidRootPart.Position - v.Character.HumanoidRootPart.Position).Magnitude
            if d < dist then dist = d near = v end
        end
    end
    if knife and near and near.Character:FindFirstChild("HumanoidRootPart") then
        local targetPart = near.Character:FindFirstChild(_G.TargetPart) or near.Character.HumanoidRootPart
        local hum = char:FindFirstChild("Humanoid")
        if hum and knife.Parent == lp.Backpack then hum:EquipTool(knife) end
        local targetPos = targetPart.Position
        executeTweenFlick(targetPos, function()
            local remote = (knife:FindFirstChild("Events") and knife.Events:FindFirstChild("KnifeThrown")) or knife:FindFirstChild("KnifeThrown")
            if remote then
                remote:FireServer({CFrame.new(char.HumanoidRootPart.Position, targetPos) * CFrame.Angles(1.453, 0.044, 1.65), CFrame.new(targetPos)})
            else
                knife:Activate()
            end
        end)
        task.delay(0.2, function()
            if knife and knife.Parent == char and lp:FindFirstChild("Backpack") then
                knife.Parent = lp.Backpack
            end
        end)
    end
end

